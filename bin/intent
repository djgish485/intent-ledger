#!/usr/bin/env python3
"""intent — the Intent Ledger CLI.

A project's requirements, kept as data in the repo: an append-only log of every
intention behind the product (.intent/backlog.jsonl) and the rules currently in
force (.intent/contracts.jsonl). Agents and contributors read before changing
behavior, append after, and sync through plain git.

Zero dependencies. Python 3.8+. See spec/FORMAT.md and playbooks/ in
https://github.com/djgish485/intent-ledger
"""
import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

KINDS = {"directive", "complaint", "preference", "idea", "pivot", "approval"}
STATUSES = {"open", "implemented", "fixed", "superseded", "rejected", "unknown", "law"}
MARK_BEGIN = "<!-- intent-ledger:begin -->"
MARK_END = "<!-- intent-ledger:end -->"

INSTRUCTION_SECTION = f"""
{MARK_BEGIN}
## Intent Ledger (read this before changing behavior)

This project keeps its requirements as data, in the repo:

- `.intent/backlog.jsonl` — every intention ever expressed behind this project: dated,
  with the author's verbatim quote, a normalized statement, and a lifecycle status
  (open/implemented/fixed/superseded/rejected). Append-only; `status:"open"` entries
  are the live project backlog.
- `.intent/contracts.jsonl` — the rules currently in force. Entries with
  `status:"law"` are permanently binding on every change.

Workflow: BEFORE changing behavior or deciding where an artifact belongs, search both
files for the territory you touch (`intent query <terms>`, or grep) and check every
law (`intent laws`). AFTER work, append new intentions expressed by the user/owner
(verbatim quote = provenance) and update statuses of entries your change implements,
fixes, or supersedes — committed together with the code.
{MARK_END}
"""

CONTRIBUTING_SECTION = f"""
{MARK_BEGIN}
## The Intent Ledger

This project records the *why* behind every behavior in `.intent/backlog.jsonl`
(append-only intent log) and `.intent/contracts.jsonl` (rules in force; `law`
entries bind every change). For any PR: search them for the territory you touch
before designing, then ship the intent behind your change as a backlog entry in
the same PR (your PR description works as the quote). Run
`git config core.hooksPath .githooks` once after cloning to get a warn-only
reminder when a behavior change is committed without an intent change.
{MARK_END}
"""

HOOK = """#!/bin/sh
# Intent Ledger reminder (warn-only, never blocks). https://github.com/djgish485/intent-ledger
changed=$(git diff --cached --name-only)
touches_behavior=$(echo "$changed" | grep -vcE '^(\\.intent/|docs/|.*\\.md$)' || true)
touches_intent=$(echo "$changed" | grep -cE '^\\.intent/' || true)
if [ "$touches_behavior" -gt 0 ] && [ "$touches_intent" -eq 0 ]; then
  echo "" >&2
  echo "[intent-ledger] This commit changes behavior but not .intent/." >&2
  echo "  1. Did you check .intent/contracts.jsonl (esp. status=law) and the backlog for this area?" >&2
  echo "  2. If this implements/fixes/supersedes a backlog entry, update its status." >&2
  echo "  3. If new intent was expressed behind this change, append it (intent append)." >&2
  echo "  Proceeding anyway — this is a reminder, not a gate." >&2
fi
exit 0
"""


def repo_root() -> Path:
    try:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True)
        return Path(out.stdout.strip())
    except subprocess.CalledProcessError:
        sys.exit("intent: not inside a git repository")


def intent_dir(root: Path) -> Path:
    return root / ".intent"


def read_jsonl(path: Path):
    if not path.exists():
        return []
    entries = []
    for n, line in enumerate(path.read_text().splitlines(), 1):
        line = line.strip()
        if not line:
            continue
        try:
            entries.append(json.loads(line))
        except json.JSONDecodeError:
            print(f"intent: warning: {path.name}:{n} is not valid JSON, skipping", file=sys.stderr)
    return entries


def entry_key(ts: str, quote: str, intent_text: str) -> str:
    return hashlib.sha1(f"{ts}|{quote or intent_text}".encode()).hexdigest()[:16]


def inject_section(path: Path, section: str, label: str) -> str:
    text = path.read_text() if path.exists() else ""
    if MARK_BEGIN in text:
        return f"{label}: already wired"
    with open(path, "a") as f:
        f.write(section)
    return f"{label}: section added"


def cmd_init(args) -> None:
    root = repo_root()
    d = intent_dir(root)
    d.mkdir(exist_ok=True)
    for name in ("backlog.jsonl", "contracts.jsonl"):
        p = d / name
        if not p.exists():
            p.touch()
    hooks = root / ".githooks"
    hooks.mkdir(exist_ok=True)
    hook_path = hooks / "pre-commit"
    if not hook_path.exists():
        hook_path.write_text(HOOK)
        hook_path.chmod(0o755)
    subprocess.run(["git", "config", "core.hooksPath", ".githooks"], cwd=root, check=False)

    results = [
        inject_section(root / "AGENTS.md", INSTRUCTION_SECTION, "AGENTS.md"),
        inject_section(root / "CLAUDE.md", INSTRUCTION_SECTION, "CLAUDE.md"),
        inject_section(root / "CONTRIBUTING.md", CONTRIBUTING_SECTION, "CONTRIBUTING.md"),
    ]
    for r in results:
        print(f"  {r}")
    print("  .intent/ scaffolding ready; pre-commit reminder wired (warn-only)")
    print("\nNext steps:")
    print("  1. Commit .intent/, .githooks/, and the instruction files.")
    print("  2. New project: start appending intents as they are expressed (intent append).")
    print("  3. Existing project: run `intent playbook retro` and hand the output to your")
    print("     coding agent with access to your chat history — it builds the backlog")
    print("     retroactively, as if the ledger had existed from day one.")


def matches(entry: dict, tokens, area, status) -> bool:
    if area and entry.get("area") != area:
        return False
    if status and entry.get("status") != status:
        return False
    hay = " ".join(str(entry.get(k, "")) for k in ("intent", "quote", "statement", "evidence")).lower()
    return all(t.lower() in hay for t in tokens)


def cmd_query(args) -> None:
    root = repo_root()
    shown = 0
    for name in ("contracts.jsonl", "backlog.jsonl"):
        entries = read_jsonl(intent_dir(root) / name)
        hits = [e for e in entries if matches(e, args.terms, args.area, args.status)]
        if not hits:
            continue
        print(f"--- {name} ({len(hits)}) ---")
        for e in hits[: args.limit]:
            if "statement" in e:
                print(f"  [{e.get('status','?'):11s}] {e['statement']}")
            else:
                print(f"  {e.get('ts','')[:10]} [{e.get('status','?'):11s}] {e.get('intent','')}")
                if args.verbose and e.get("quote"):
                    print(f"      “{e['quote'][:200]}”")
        shown += len(hits)
    if not shown:
        print("no matches — try fewer/different terms, or `intent laws` for the standing rules")


def cmd_laws(args) -> None:
    root = repo_root()
    laws = [e for e in read_jsonl(intent_dir(root) / "contracts.jsonl") if e.get("status") == "law"]
    if not laws:
        print("no laws recorded yet (contracts with status \"law\" bind every change)")
        return
    for e in laws:
        print(f"  LAW: {e.get('statement','')}")


def cmd_open(args) -> None:
    root = repo_root()
    entries = [e for e in read_jsonl(intent_dir(root) / "backlog.jsonl") if e.get("status") == "open"]
    entries.sort(key=lambda e: e.get("ts", ""))
    for e in entries:
        print(f"  {e.get('ts','')[:10]} [{e.get('area','')}] {e.get('intent','')}")
    print(f"({len(entries)} open)")


def cmd_append(args) -> None:
    root = repo_root()
    raw = args.json if args.json else sys.stdin.read()
    d = json.loads(raw)
    ts = d.get("ts") or datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    if not d.get("intent"):
        sys.exit("intent: entry needs an \"intent\" field (1-2 sentence normalized statement)")
    entry = {
        "key": d.get("key") or entry_key(ts, d.get("quote", ""), d["intent"]),
        "ts": ts,
        "kind": d.get("kind") if d.get("kind") in KINDS else "directive",
        "area": d.get("area", "other"),
        "intent": d["intent"],
    }
    for opt in ("quote", "status_note", "supersedes", "author", "added_by"):
        if d.get(opt):
            entry[opt] = d[opt]
    entry["status"] = d.get("status") if d.get("status") in STATUSES else "open"
    path = intent_dir(root) / "backlog.jsonl"
    existing = {e.get("key") for e in read_jsonl(path)}
    if entry["key"] in existing:
        sys.exit(f"intent: entry {entry['key']} already exists")
    with open(path, "a") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    print(f"appended {entry['key']} — commit .intent/backlog.jsonl with your change")


def cmd_status(args) -> None:
    root = repo_root()
    path = intent_dir(root) / "backlog.jsonl"
    if args.new_status not in STATUSES:
        sys.exit(f"intent: status must be one of {sorted(STATUSES)}")
    lines = path.read_text().splitlines()
    hit = False
    out = []
    for line in lines:
        if line.strip():
            e = json.loads(line)
            if e.get("key") == args.key:
                e["status"] = args.new_status
                if args.note:
                    e["status_note"] = args.note
                line = json.dumps(e, ensure_ascii=False)
                hit = True
        out.append(line)
    if not hit:
        sys.exit(f"intent: no entry with key {args.key}")
    path.write_text("\n".join(out) + "\n")
    print(f"{args.key} -> {args.new_status} — commit .intent/backlog.jsonl")


def cmd_index(args) -> None:
    import sqlite3
    root = repo_root()
    db_path = intent_dir(root) / "index.sqlite"
    conn = sqlite3.connect(db_path)
    try:
        conn.execute("DROP TABLE IF EXISTS backlog_fts")
        conn.execute("CREATE VIRTUAL TABLE backlog_fts USING fts5(intent, quote, key, ts, area, status)")
    except sqlite3.OperationalError:
        sys.exit("intent: this Python's sqlite3 lacks FTS5; plain `intent query` works fine without it")
    for e in read_jsonl(intent_dir(root) / "backlog.jsonl"):
        conn.execute(
            "INSERT INTO backlog_fts VALUES (?, ?, ?, ?, ?, ?)",
            (e.get("intent", ""), e.get("quote", ""), e.get("key", ""), e.get("ts", ""), e.get("area", ""), e.get("status", "")),
        )
    conn.commit()
    n = conn.execute("SELECT count(*) FROM backlog_fts").fetchone()[0]
    print(f"indexed {n} entries -> .intent/index.sqlite (derived; do not commit)")


def cmd_playbook(args) -> None:
    base = Path(__file__).resolve().parent.parent / "playbooks"
    names = {"retro": "retroactive-build.md", "induce": "principle-induction.md",
             "audit": "silent-constraints-audit.md", "loop": "maintenance-loop.md"}
    path = base / names[args.name]
    if not path.exists():
        sys.exit(f"intent: playbook not found at {path} — run from a full checkout of intent-ledger,"
                 f" or read it at https://github.com/djgish485/intent-ledger/blob/main/playbooks/{names[args.name]}")
    print(path.read_text())


def cmd_doctor(args) -> None:
    root = repo_root()
    checks = []
    d = intent_dir(root)
    checks.append(("backlog.jsonl exists", (d / "backlog.jsonl").exists()))
    checks.append(("contracts.jsonl exists", (d / "contracts.jsonl").exists()))
    bad = 0
    for name in ("backlog.jsonl", "contracts.jsonl"):
        p = d / name
        if p.exists():
            for line in p.read_text().splitlines():
                if line.strip():
                    try:
                        json.loads(line)
                    except json.JSONDecodeError:
                        bad += 1
    checks.append(("all entries parse as JSON", bad == 0))
    hooks_path = subprocess.run(["git", "config", "core.hooksPath"], cwd=root, capture_output=True, text=True).stdout.strip()
    checks.append(("core.hooksPath set to .githooks", hooks_path == ".githooks"))
    checks.append((".githooks/pre-commit present", (root / ".githooks" / "pre-commit").exists()))
    for f in ("AGENTS.md", "CLAUDE.md"):
        p = root / f
        checks.append((f"{f} carries the mandate", p.exists() and MARK_BEGIN in p.read_text()))
    ok = True
    for label, passed in checks:
        print(f"  {'ok ' if passed else 'FAIL'} {label}")
        ok = ok and passed
    keys = [e.get("key") for e in read_jsonl(d / "backlog.jsonl")]
    dupes = len(keys) - len(set(keys))
    if dupes:
        print(f"  FAIL {dupes} duplicate keys in backlog")
        ok = False
    sys.exit(0 if ok else 1)


def main() -> None:
    p = argparse.ArgumentParser(prog="intent", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("init", help="scaffold .intent/, hook, and instruction-file sections").set_defaults(fn=cmd_init)

    q = sub.add_parser("query", help="search backlog + contracts")
    q.add_argument("terms", nargs="+")
    q.add_argument("--area")
    q.add_argument("--status")
    q.add_argument("--limit", type=int, default=25)
    q.add_argument("-v", "--verbose", action="store_true")
    q.set_defaults(fn=cmd_query)

    sub.add_parser("laws", help="print the contracts that bind every change").set_defaults(fn=cmd_laws)
    sub.add_parser("open", help="list open backlog entries (the live to-do list)").set_defaults(fn=cmd_open)

    a = sub.add_parser("append", help="append a backlog entry (JSON arg or stdin)")
    a.add_argument("json", nargs="?")
    a.set_defaults(fn=cmd_append)

    s = sub.add_parser("status", help="update an entry's lifecycle status")
    s.add_argument("key")
    s.add_argument("new_status")
    s.add_argument("note", nargs="?")
    s.set_defaults(fn=cmd_status)

    sub.add_parser("index", help="build optional FTS index (derived, never committed)").set_defaults(fn=cmd_index)

    pb = sub.add_parser("playbook", help="print an agent playbook (retro|induce|audit|loop)")
    pb.add_argument("name", choices=["retro", "induce", "audit", "loop"])
    pb.set_defaults(fn=cmd_playbook)

    sub.add_parser("doctor", help="check the ledger wiring in this repo").set_defaults(fn=cmd_doctor)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
