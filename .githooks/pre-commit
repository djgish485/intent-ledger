#!/bin/sh
# Intent Ledger reminder (warn-only, never blocks). https://github.com/djgish485/intent-ledger
changed=$(git diff --cached --name-only)
touches_behavior=$(echo "$changed" | grep -vcE '^(\.intent/|docs/|.*\.md$)' || true)
touches_intent=$(echo "$changed" | grep -cE '^\.intent/' || true)
if [ "$touches_behavior" -gt 0 ] && [ "$touches_intent" -eq 0 ]; then
  echo "" >&2
  echo "[intent-ledger] This commit changes behavior but not .intent/." >&2
  echo "  1. Did you check .intent/contracts.jsonl (esp. status=law) and the backlog for this area?" >&2
  echo "  2. If this implements/fixes/supersedes a backlog entry, update its status." >&2
  echo "  3. If new intent was expressed behind this change, append it (intent append)." >&2
  echo "  Proceeding anyway — this is a reminder, not a gate." >&2
fi
exit 0
